# Copy to .env for local use. Never commit real API keys.
# Optional but recommended: improves project/team/funding lookups.
ROOTDATA_API_KEY=your_rootdata_api_key_here
# Optional but recommended: improves ETH and other Etherscan-supported chain checks.
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Optional but recommended: improves BNB Chain / BSC checks.
BSCSCAN_API_KEY=your_bscscan_api_key_here
BN_ALPHA_MONITOR_DATA_DIR=./data/monitor_snapshots
